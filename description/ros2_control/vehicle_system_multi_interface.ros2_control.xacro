<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="vehicle_system_multi_interface" params="name prefix serial_port state_update_frequency use_hardware world_frame_id body_frame_id map_frame_id same_initial_conditions use_pwm use_dvl dvl_host dvl_port manual_control:=false">

    <ros2_control name="${name}" type="system">

      <hardware>
        <xacro:if value="${use_hardware}">
          <plugin>ros2_control_blue_reach_5/BlueRovSystemMultiInterfaceHardware</plugin>
          <param name="prefix">${prefix}</param>
          <param name="world_frame_id">${world_frame_id}</param>
          <param name="body_frame_id">${body_frame_id}</param>
          <param name="map_frame_id">${map_frame_id}</param>
          <param name="same_initial_conditions">${same_initial_conditions}</param>
          <param name="use_pwm">${use_pwm}</param>
          <param name="use_dvl">${use_dvl}</param>
          <param name="manual_control">${manual_control}</param>
          <!-- Dropout limits, not update periods. Pressure is normally 2 Hz. -->
          <param name="imu_timeout_s">0.5</param>
          <param name="pressure_timeout_s">1.5</param>
          <param name="dvl_timeout_s">0.5</param>
          <param name="dvl_host">${dvl_host}</param>
          <param name="dvl_port">${dvl_port}</param>
        </xacro:if>

        <xacro:unless value="${use_hardware}">
          <plugin>ros2_control_blue_reach_5/SimVehicleSystemMultiInterfaceHardware</plugin>
          <param name="prefix">${prefix}</param>
          <param name="world_frame_id">${world_frame_id}</param>
          <param name="body_frame_id">${body_frame_id}</param>
          <param name="map_frame_id">${map_frame_id}</param>
          <param name="same_initial_conditions">${same_initial_conditions}</param>
          <param name="use_pwm">${use_pwm}</param>
        </xacro:unless>
      </hardware>

      <joint name="${prefix}thruster1_joint">
        <param name="param_name">SERVO1_FUNCTION</param>
        <param name="default_param_value">33</param>
        <param name="channel">1</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>

        <command_interface name="pwm"/>
      </joint>

      <joint name="${prefix}thruster2_joint">
        <param name="param_name">SERVO2_FUNCTION</param>
        <param name="default_param_value">34</param>
        <param name="channel">2</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>
        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

       <joint name="${prefix}thruster3_joint">
        <param name="param_name">SERVO3_FUNCTION</param>
        <param name="default_param_value">35</param>
        <param name="channel">3</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">-1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

       <joint name="${prefix}thruster4_joint">
        <param name="param_name">SERVO4_FUNCTION</param>
        <param name="default_param_value">36</param>
        <param name="channel">4</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">-1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

       <joint name="${prefix}thruster5_joint">
        <param name="param_name">SERVO5_FUNCTION</param>
        <param name="default_param_value">37</param>
        <param name="channel">5</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

       <joint name="${prefix}thruster6_joint">
        <param name="param_name">SERVO6_FUNCTION</param>
        <param name="default_param_value">38</param>
        <param name="channel">6</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>
       <joint name="${prefix}thruster7_joint">
        <param name="param_name">SERVO7_FUNCTION</param>
        <param name="default_param_value">39</param>
        <param name="channel">7</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

       <joint name="${prefix}thruster8_joint">
        <param name="param_name">SERVO8_FUNCTION</param>
        <param name="default_param_value">40</param>
        <param name="channel">8</param>
        <param name="neutral_pwm">1500</param>
        <param name="direction">1</param>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="pwm"/>
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>
        <command_interface name="pwm"/>
      </joint>

      <gpio name="${prefix}IOs">
        <param name="Light1_channel">13</param>
        <param name="Light2_channel">14</param>
        <param name="CameraMountPitch_channel">16</param>

        <command_interface name="position.x"/>
        <command_interface name="position.y"/>
        <command_interface name="position.z"/>

        <command_interface name="roll"/>
        <command_interface name="pitch"/>
        <command_interface name="yaw"/>

        <command_interface name="orientation.w"/>
        <command_interface name="orientation.x"/>
        <command_interface name="orientation.y"/>
        <command_interface name="orientation.z"/>

        <command_interface name="velocity.x"/>
        <command_interface name="velocity.y"/>
        <command_interface name="velocity.z"/>
        <command_interface name="angular_velocity.x"/>
        <command_interface name="angular_velocity.y"/>
        <command_interface name="angular_velocity.z"/>

        <command_interface name="linear_acceleration.x"/>
        <command_interface name="linear_acceleration.y"/>
        <command_interface name="linear_acceleration.z"/>
        <command_interface name="angular_acceleration.x"/>
        <command_interface name="angular_acceleration.y"/>
        <command_interface name="angular_acceleration.z"/>

        <command_interface name="force.x"/>
        <command_interface name="force.y"/>
        <command_interface name="force.z"/>
        <command_interface name="torque.x"/>
        <command_interface name="torque.y"/>
        <command_interface name="torque.z"/>

        <state_interface name="position.x"/>
        <state_interface name="position.y"/>
        <state_interface name="position.z"/>

        <state_interface name="roll"/>
        <state_interface name="pitch"/>
        <state_interface name="yaw"/>

        <state_interface name="orientation.w"/>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>

        <state_interface name="velocity.x"/>
        <state_interface name="velocity.y"/>
        <state_interface name="velocity.z"/>

        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>

        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>

        <state_interface name="angular_acceleration.x"/>
        <state_interface name="angular_acceleration.y"/>
        <state_interface name="angular_acceleration.z"/>

        <state_interface name="force.x"/>
        <state_interface name="force.y"/>
        <state_interface name="force.z"/>
        <state_interface name="torque.x"/>
        <state_interface name="torque.y"/>
        <state_interface name="torque.z"/>
        
        <state_interface name="sim_time"/>
        <state_interface name="sim_period"/>

        <state_interface name="imu_roll"/>
        <state_interface name="imu_pitch"/>
        <state_interface name="imu_yaw"/>

        <state_interface name="imu_roll_unwrap"/>
        <state_interface name="imu_pitch_unwrap"/>
        <state_interface name="imu_yaw_unwrap"/>

        <state_interface name="imu_orientation_w"/>
        <state_interface name="imu_orientation_x"/>
        <state_interface name="imu_orientation_y"/>
        <state_interface name="imu_orientation_z"/>

        <state_interface name="imu_angular_vel_x"/>
        <state_interface name="imu_angular_vel_y"/>
        <state_interface name="imu_angular_vel_z"/>

        <state_interface name="imu_linear_acceleration_x"/>
        <state_interface name="imu_linear_acceleration_y"/>
        <state_interface name="imu_linear_acceleration_z"/>

        <state_interface name="depth_from_pressure2"/>

        <state_interface name="dvl_gyro_roll"/>
        <state_interface name="dvl_gyro_pitch"/>
        <state_interface name="dvl_gyro_yaw"/>

        <state_interface name="dvl_speed_x"/>
        <state_interface name="dvl_speed_y"/>
        <state_interface name="dvl_speed_z"/>

        <state_interface name="position_estimate.x"/>
        <state_interface name="position_estimate.y"/>
        <state_interface name="position_estimate.z"/>

        <state_interface name="roll_estimate"/>
        <state_interface name="pitch_estimate"/>
        <state_interface name="yaw_estimate"/>

        <state_interface name="orientation_estimate.w"/>
        <state_interface name="orientation_estimate.x"/>
        <state_interface name="orientation_estimate.y"/>
        <state_interface name="orientation_estimate.z"/>

        <state_interface name="velocity_estimate.x"/>
        <state_interface name="velocity_estimate.y"/>
        <state_interface name="velocity_estimate.z"/>

        <state_interface name="angular_velocity_estimate.x"/>
        <state_interface name="angular_velocity_estimate.y"/>
        <state_interface name="angular_velocity_estimate.z"/>

        <state_interface name="P_x_x"/>
        <state_interface name="P_y_y"/>
        <state_interface name="P_z_z"/>
        <state_interface name="P_roll_roll"/>
        <state_interface name="P_pitch_pitch"/>
        <state_interface name="P_yaw_yaw"/>
        <state_interface name="P_u_u"/>
        <state_interface name="P_v_v"/>
        <state_interface name="P_w_w"/>
        <state_interface name="P_p_p"/>
        <state_interface name="P_q_q"/>
        <state_interface name="P_r_r"/>
        <state_interface name="control_power_abs"/>
        <state_interface name="control_energy_abs"/>
        <xacro:unless value="${use_hardware}">
          <state_interface name="sim_step"/>
          <state_interface name="sensor_sample_time.0"/>
          <state_interface name="sensor_sample_time.1"/>
          <state_interface name="sensor_sample_time.2"/>
          <xacro:unless value="${use_hardware}">
            <state_interface name="sensor_noise_enabled"/>
          </xacro:unless>
          <state_interface name="sensor_new.0"/>
          <state_interface name="sensor_new.1"/>
          <state_interface name="sensor_new.2"/>
          <state_interface name="sensor_new.3"/>
          <state_interface name="sensor_new.4"/>
          <state_interface name="sensor_new.5"/>
          <state_interface name="sensor_new.6"/>
          <state_interface name="sensor_new.7"/>
          <state_interface name="sensor_new.8"/>
          <state_interface name="sensor_new.9"/>
          <state_interface name="sensor_new.10"/>
          <state_interface name="sensor_new.11"/>
          <state_interface name="sensor_new.12"/>
          <state_interface name="sim_generation"/>
          <state_interface name="estimator_model_retained"/>
          <state_interface name="estimator_model_epoch"/>
          <state_interface name="estimator_model_accepted_time"/>
        </xacro:unless>
          <state_interface name="estimated_disturbance.force.x"/>
          <state_interface name="estimated_disturbance.variance.force.x"/>
          <state_interface name="estimated_disturbance.force.y"/>
          <state_interface name="estimated_disturbance.variance.force.y"/>
          <state_interface name="estimated_disturbance.force.z"/>
          <state_interface name="estimated_disturbance.variance.force.z"/>
          <state_interface name="estimated_disturbance.torque.x"/>
          <state_interface name="estimated_disturbance.variance.torque.x"/>
          <state_interface name="estimated_disturbance.torque.y"/>
          <state_interface name="estimated_disturbance.variance.torque.y"/>
          <state_interface name="estimated_disturbance.torque.z"/>
          <state_interface name="estimated_disturbance.variance.torque.z"/>
          <state_interface name="estimator_step"/>
          <state_interface name="estimator_valid"/>
          <state_interface name="estimator_noise.intensity.0"/>
          <state_interface name="estimator_noise.intensity.1"/>
          <state_interface name="estimator_noise.intensity.2"/>
          <state_interface name="estimator_noise.intensity.3"/>
          <state_interface name="estimator_noise.intensity.4"/>
          <state_interface name="estimator_noise.intensity.5"/>
          <state_interface name="estimator_noise.enabled"/>
          <state_interface name="estimator_noise.applied_fit_count"/>
          <state_interface name="estimator_noise.dropped"/>
          <state_interface name="estimator_noise.failed"/>
          <state_interface name="estimator_noise.fit_seconds"/>
          <state_interface name="estimator_noise.endpoint_step"/>
        <xacro:if value="${use_hardware}">
          <state_interface name="identification.valid"/>
          <state_interface name="identification.generation"/>
          <state_interface name="identification.step"/>
          <state_interface name="identification.time"/>
          <state_interface name="identification.period"/>
          <state_interface name="identification.depth"/>
          <state_interface name="identification.attitude.0"/>
          <state_interface name="identification.attitude.1"/>
          <state_interface name="identification.attitude.2"/>
          <state_interface name="identification.velocity.0"/>
          <state_interface name="identification.velocity.1"/>
          <state_interface name="identification.velocity.2"/>
          <state_interface name="identification.velocity.3"/>
          <state_interface name="identification.velocity.4"/>
          <state_interface name="identification.velocity.5"/>
          <state_interface name="identification.wrench.0"/>
          <state_interface name="identification.wrench.1"/>
          <state_interface name="identification.wrench.2"/>
          <state_interface name="identification.wrench.3"/>
          <state_interface name="identification.wrench.4"/>
          <state_interface name="identification.wrench.5"/>
        </xacro:if>
          <state_interface name="estimator_nominal_parameter.0"/>
          <state_interface name="estimator_nominal_parameter.1"/>
          <state_interface name="estimator_nominal_parameter.2"/>
          <state_interface name="estimator_nominal_parameter.3"/>
          <state_interface name="estimator_nominal_parameter.4"/>
          <state_interface name="estimator_nominal_parameter.5"/>
          <state_interface name="estimator_nominal_parameter.6"/>
          <state_interface name="estimator_nominal_parameter.7"/>
          <state_interface name="estimator_nominal_parameter.8"/>
          <state_interface name="estimator_nominal_parameter.9"/>
          <state_interface name="estimator_nominal_parameter.10"/>
          <state_interface name="estimator_nominal_parameter.11"/>
          <state_interface name="estimator_nominal_parameter.12"/>
          <state_interface name="estimator_nominal_parameter.13"/>
          <state_interface name="estimator_nominal_parameter.14"/>
          <state_interface name="estimator_nominal_parameter.15"/>
          <state_interface name="estimator_nominal_parameter.16"/>
          <state_interface name="estimator_nominal_parameter.17"/>
          <state_interface name="estimator_nominal_parameter.18"/>
          <state_interface name="estimator_nominal_parameter.19"/>
          <state_interface name="estimator_nominal_parameter.20"/>
          <state_interface name="estimator_nominal_parameter.21"/>
          <state_interface name="estimator_nominal_parameter.22"/>
          <state_interface name="estimator_nominal_parameter.23"/>
          <state_interface name="estimator_nominal_parameter.24"/>
          <state_interface name="estimator_nominal_parameter.25"/>
          <state_interface name="estimator_nominal_parameter.26"/>
          <state_interface name="estimator_nominal_parameter.27"/>
          <state_interface name="estimator_nominal_parameter.28"/>
          <state_interface name="estimator_nominal_parameter.29"/>
          <state_interface name="estimator_nominal_parameter.30"/>
          <state_interface name="estimator_nominal_parameter.31"/>
          <state_interface name="estimator_nominal_parameter.32"/>

        <!-- Full FRD wrench covariance, row-major force xyz then torque xyz. -->
        <state_interface name="estimated_disturbance.covariance.0.0"/>
        <state_interface name="estimated_disturbance.covariance.0.1"/>
        <state_interface name="estimated_disturbance.covariance.0.2"/>
        <state_interface name="estimated_disturbance.covariance.0.3"/>
        <state_interface name="estimated_disturbance.covariance.0.4"/>
        <state_interface name="estimated_disturbance.covariance.0.5"/>
        <state_interface name="estimated_disturbance.covariance.1.0"/>
        <state_interface name="estimated_disturbance.covariance.1.1"/>
        <state_interface name="estimated_disturbance.covariance.1.2"/>
        <state_interface name="estimated_disturbance.covariance.1.3"/>
        <state_interface name="estimated_disturbance.covariance.1.4"/>
        <state_interface name="estimated_disturbance.covariance.1.5"/>
        <state_interface name="estimated_disturbance.covariance.2.0"/>
        <state_interface name="estimated_disturbance.covariance.2.1"/>
        <state_interface name="estimated_disturbance.covariance.2.2"/>
        <state_interface name="estimated_disturbance.covariance.2.3"/>
        <state_interface name="estimated_disturbance.covariance.2.4"/>
        <state_interface name="estimated_disturbance.covariance.2.5"/>
        <state_interface name="estimated_disturbance.covariance.3.0"/>
        <state_interface name="estimated_disturbance.covariance.3.1"/>
        <state_interface name="estimated_disturbance.covariance.3.2"/>
        <state_interface name="estimated_disturbance.covariance.3.3"/>
        <state_interface name="estimated_disturbance.covariance.3.4"/>
        <state_interface name="estimated_disturbance.covariance.3.5"/>
        <state_interface name="estimated_disturbance.covariance.4.0"/>
        <state_interface name="estimated_disturbance.covariance.4.1"/>
        <state_interface name="estimated_disturbance.covariance.4.2"/>
        <state_interface name="estimated_disturbance.covariance.4.3"/>
        <state_interface name="estimated_disturbance.covariance.4.4"/>
        <state_interface name="estimated_disturbance.covariance.4.5"/>
        <state_interface name="estimated_disturbance.covariance.5.0"/>
        <state_interface name="estimated_disturbance.covariance.5.1"/>
        <state_interface name="estimated_disturbance.covariance.5.2"/>
        <state_interface name="estimated_disturbance.covariance.5.3"/>
        <state_interface name="estimated_disturbance.covariance.5.4"/>
        <state_interface name="estimated_disturbance.covariance.5.5"/>
        <state_interface name="linear_acceleration_estimate.x"/>
        <state_interface name="linear_acceleration_estimate.y"/>
        <state_interface name="linear_acceleration_estimate.z"/>
        <state_interface name="angular_acceleration_estimate.x"/>
        <state_interface name="angular_acceleration_estimate.y"/>
        <state_interface name="angular_acceleration_estimate.z"/>
      </gpio>

    </ros2_control>
  </xacro:macro>

</robot>
