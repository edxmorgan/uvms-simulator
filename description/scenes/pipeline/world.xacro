<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="scene_environment" params="world_frame asset_directory">
    <link name="bathymetry_seabed_0">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/flat_d0400a79f011.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/flat_cd5e00fbb6e4.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>
    <joint name="bathymetry_seabed_0_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="bathymetry_seabed_0" />
      <origin xyz="0 0 -8" rpy="3.1415926535897931 0 0" />
    </joint>
    <link name="bathymetry_pipe_1">
      <collision>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/pipestri_c924d749707e.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/pipestri_972c75fd89ef.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>
    <joint name="bathymetry_pipe_1_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="bathymetry_pipe_1" />
      <origin xyz="0 -8 -7" rpy="3.1415926535897931 0 0" />
    </joint>
    <link name="bathymetry_pipe_2">
      <collision>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/pipestri_c924d749707e.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/pipestri_972c75fd89ef.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>
    <joint name="bathymetry_pipe_2_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="bathymetry_pipe_2" />
      <origin xyz="0 8 -7" rpy="3.1415926535897931 0 0" />
    </joint>
    <link name="world_bottom" />
    <joint name="world_bottom_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="world_bottom" />
      <origin xyz="0 0 -8" rpy="0 0 0" />
    </joint>
  </xacro:macro>
</robot>