<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="scene_environment" params="world_frame asset_directory">
    <link name="bathymetry_seabed_0">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/flat_3bfed30138de.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/flat_d00f84a97ff1.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>
    <joint name="bathymetry_seabed_0_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="bathymetry_seabed_0" />
      <origin xyz="0 0 -8" rpy="3.1415926535897931 0 0" />
    </joint>
    <link name="bathymetry_ship_1">
      <collision>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/shipwreck_8de94ad05f98.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="3.1400000000000001 0 0" />
        <geometry>
          <mesh filename="file://${asset_directory}/assets/shipwreck_37c1a0618d85.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>
    <joint name="bathymetry_ship_1_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="bathymetry_ship_1" />
      <origin xyz="0 0 -7.5" rpy="3.1415926535897931 0 0" />
    </joint>
    <link name="world_bottom" />
    <joint name="world_bottom_joint" type="fixed">
      <parent link="${world_frame}" />
      <child link="world_bottom" />
      <origin xyz="0 0 -8" rpy="0 0 0" />
    </joint>
  </xacro:macro>
</robot>